# ============================================================
# CONFIGURACIÓN GENERAL DEL STACK DE MONITOREO — PLANTILLA
# ============================================================
# Copia este archivo a env.conf y reemplaza TODOS los valores.
#   cp env.conf.example env.conf
# NUNCA subas env.conf al repositorio (está en .gitignore).

# --- IP/Hostname del servidor donde corre este stack ---
SERVER_IP=192.0.2.10

# --- Zona horaria ---
TZ=America/Santiago

# ============================================================
# POSTGRESQL (Base de datos para Zabbix)
# ============================================================
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ============================================================
# ZABBIX SERVER
# ============================================================
ZABBIX_VERSION=7.0-ubuntu-latest
ZBX_SERVER_HOST=zabbix-server
ZBX_JAVAGATEWAY_ENABLE=false
ZBX_STARTSNMPTRAPPER=1

# ============================================================
# ZABBIX WEB (Frontend Nginx)
# ============================================================
ZBX_SERVER_NAME="Mi Monitoreo"
PHP_TZ=America/Santiago

# ============================================================
# GRAFANA
# ============================================================
GRAFANA_VERSION=11.4.0
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_strong_password
GF_INSTALL_PLUGINS=alexanderzobnin-zabbix-app
GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS=alexanderzobnin-zabbix-datasource

# Contraseña que Grafana usa para conectarse a la API de Zabbix (datasource)
ZABBIX_API_PASSWORD=CHANGE_ME_zabbix_api_password

# ============================================================
# WAZUH
# ============================================================
WAZUH_VERSION=4.9.2
WAZUH_INDEXER_PASSWORD=CHANGE_ME_strong_password
WAZUH_API_PASSWORD=CHANGE_ME_strong_password
WAZUH_DASHBOARD_PASSWORD=CHANGE_ME_strong_password

# ============================================================
# SNMPv3 - Credenciales para dispositivos de red (FortiGate / OPNsense)
# ============================================================
SNMP_USER=CHANGE_ME_snmp_user
SNMP_AUTH_PASS=CHANGE_ME_snmp_auth
SNMP_PRIV_PASS=CHANGE_ME_snmp_priv
SNMP_AUTH_PROTOCOL=SHA
SNMP_PRIV_PROTOCOL=AES

# ============================================================
# RED DE MONITOREO - IPs de los equipos a monitorear (ejemplos)
# ============================================================
FW_DATACENTER=192.0.2.1
FW_MEXICO=192.0.2.2
FW_CURICO=192.0.2.3
FW_SAN_CARLOS=192.0.2.4
FW_VITACURA=192.0.2.5
FW_OPNSENSE=192.0.2.6
